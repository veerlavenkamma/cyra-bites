rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Model Validation helper
    function isValidUser(user) {
      return user.keys().hasAll(['uid', 'name', 'avatar', 'rewardsPoints', 'favorites', 'cart'])
        && user.keys().size() == 6
        && user.uid == request.auth.uid
        && user.name is string && user.name.size() <= 100
        && user.avatar is string && user.avatar.size() <= 10
        && user.rewardsPoints is int
        && user.favorites is list
        && user.cart is list;
    }

    // Address Model Validation helper
    function isValidAddress(addr) {
      return addr.keys().hasAll(['id', 'label', 'labelTelugu', 'addressLine', 'addressLineTelugu', 'isDefault', 'city'])
        && addr.keys().size() <= 8
        && addr.id is string && addr.id.size() <= 64
        && addr.label is string && addr.label.size() <= 100
        && addr.labelTelugu is string && addr.labelTelugu.size() <= 100
        && addr.addressLine is string && addr.addressLine.size() <= 1000
        && addr.addressLineTelugu is string && addr.addressLineTelugu.size() <= 1000
        && addr.isDefault is bool
        && addr.city is string && addr.city.size() <= 100;
    }

    // Order Model Validation helper
    function isValidOrder(order) {
      return order.keys().hasAll(['id', 'date', 'foodName', 'amount', 'status'])
        && order.keys().size() <= 6
        && order.id is string && order.id.size() <= 128
        && order.date is string && order.date.size() <= 100
        && order.foodName is string && order.foodName.size() <= 200
        && order.amount is number
        && order.status is string && (order.status == 'Delivered' || order.status == 'Pending' || order.status == 'Cancelled');
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid) && isValidUser(request.resource.data);
      allow update: if isOwner(uid) && isValidUser(request.resource.data);
      allow delete: if false;

      match /addresses/{addressId} {
        allow list, get: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidId(addressId) && isValidAddress(request.resource.data);
        allow delete: if isOwner(uid) && isValidId(addressId);
      }

      match /orders/{orderId} {
        allow list, get: if isOwner(uid);
        allow create: if isOwner(uid) && isValidId(orderId) && isValidOrder(request.resource.data);
        allow update: if isOwner(uid) && isValidId(orderId) && isValidOrder(request.resource.data);
        allow delete: if false;
      }
    }
  }
}
